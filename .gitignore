# secrets - the live compose file holds the API token inline, so it must never
# be committed. docker-compose.yml.example is the tracked template.
docker-compose.yml
!docker-compose.yml.example

# kept as a safety net in case a .env is ever reintroduced
.env
*.env

# runtime state (regenerated, must never be committed)
data/
screenshots/
*.png

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# editors / os
.vscode/
.idea/
.DS_Store
Thumbs.db
