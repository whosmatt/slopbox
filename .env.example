# example for hetzner
QWEN_API_KEY=replace-me
QWEN_BASE_URL=https://inference.hetzner.com/api/v1
QWEN_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# Admin token for /admin/* endpoints (reset styles). Generate your own.
ADMIN_TOKEN=change-me

# Agent limits
MAX_STEPS=14
# Qwen3.6 is a reasoning model; "low" keeps it thinking usefully without
# stalling the UI. Options follow the OpenAI reasoning_effort convention.
REASONING_EFFORT=low
MAX_TOKENS=12000
MAX_CONTEXT_CHARS=240000
MAX_CSS_BYTES=100000
MAX_PROMPT_CHARS=600

# Rate limit: prompts per IP per window
RATE_LIMIT_COUNT=5
RATE_LIMIT_WINDOW_SEC=120

# Comma-separated peers whose X-Forwarded-For may be believed. Leave EMPTY
# unless a reverse proxy sits in front: trusting the header from anyone lets a
# caller mint a fresh identity per request and walk through the rate limiter.
TRUSTED_PROXIES=

# Published stylesheet versions kept on disk (oldest pruned on every write).
HISTORY_KEEP=20
