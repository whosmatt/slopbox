services:
  slopbox:
    image: whosmatt/slopbox:latest
    container_name: slopbox
    init: true
    restart: unless-stopped
    ports:
      - "8012:8000"
    environment:
      # OpenAI compatible API
      QWEN_API_KEY: "xxx"
      # Guards /admin/reset and /admin/rollback. Leave empty to disable them.
      ADMIN_TOKEN: "xxx"

      QWEN_BASE_URL: "https://inference.hetzner.com/api/v1"
      QWEN_MODEL: "Qwen/Qwen3.6-35B-A3B-FP8"
      DATA_DIR: "/data"

      # Agent limits. app/config.py carries the same defaults, so any line below
      # can simply be deleted rather than tuned.
      MAX_STEPS: "14"
      REASONING_EFFORT: "low"
      MAX_TOKENS: "12000"
      MAX_CONTEXT_CHARS: "240000"
      MAX_CSS_BYTES: "100000"
      MAX_PROMPT_CHARS: "600"

      # Designs kept on disk for the /gallery page - stylesheet, thumbnail and
      # prompt each, pruned together. Oldest ages out on every publish.
      HISTORY_KEEP: "20"

      # Prompts per IP per window.
      RATE_LIMIT_COUNT: "5"
      RATE_LIMIT_WINDOW_SEC: "120"

      # What the agent may do beyond plain CSS. Setting one to 0 removes its
      # tool, drops it from the system prompt and closes its route, so a
      # capability that invites abuse can be revoked without a rollback.
      ENABLE_FONTS: "1"     # locally served font families
      ENABLE_ASSETS: "1"    # built-in tileable patterns via url(/assets/NAME)
      ENABLE_HTML: "1"      # inert markup + inline SVG in #qb-decor
      ENABLE_SKETCH: "1"    # scripted document in a null-origin sandboxed iframe
      MAX_DECOR_BYTES: "20000"
      MAX_SKETCH_BYTES: "20000"

      # Match to subnet when using a reverse proxy or leave empty
      TRUSTED_PROXIES: "172.28.0.1"
    volumes:
      # Runtime volume
      - slopbox-data:/data
      # Only needed to run the browser test suite from a checkout; the image
      # itself ships without tests.
      - ./tests:/app/tests:ro
    tmpfs:
      # Chromium's scratch space, wiped on every restart.
      - /tmp:size=256m
    # Chromium is memory-hungry; cap it so a runaway render cannot take the host.
    mem_limit: 2g
    shm_size: 512m
    security_opt:
      - no-new-privileges:true

volumes:
  slopbox-data:

networks:
  default:
    ipam:
      config:
        # Change if already in use
        - subnet: 172.28.0.0/24
          gateway: 172.28.0.1
